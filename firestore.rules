rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ───── 누구인지 확인 ─────
    // 구글이나 애플로 로그인한 사용자만 (방문자/익명 제외)
    function isMember() {
      return request.auth != null
        && ('google.com' in request.auth.token.firebase.identities
          || 'apple.com' in request.auth.token.firebase.identities);
    }
    // 내 회원 정보 (서버에 저장된 값이라 브라우저에서 조작할 수 없음)
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // 차단되지 않은 회원
    function isActive() {
      return isMember() && me().banned == false;
    }
    function isAdmin() {
      return isActive() && me().role == 'admin';
    }
    // 사이트 주인: 이메일을 그대로 적지 않고 SHA-256 값으로만 비교
    function isOwner() {
      return isMember()
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == 'a74afa58f75b50e5740dd656a4e57c01c4659511c4ce88703db3f3267ef63d86';
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validProfile(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.photoURL is string && d.photoURL.size() <= 60000
        && d.photoURL.matches('(https://.*|data:image/jpeg;base64,[A-Za-z0-9+/=]*)?');
    }

    // ───── 회원 (닉네임 · 프로필 사진 · 권한 · 차단 여부) ─────
    match /users/{uid} {
      allow read: if isMember();

      // 처음 가입: 권한은 항상 일반 회원. 주인만 관리자로 시작할 수 있음
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'role', 'banned', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'photoURL', 'role', 'banned', 'createdAt'])
        && validProfile(request.resource.data)
        && (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isOwner()))
        && request.resource.data.banned == false
        && request.resource.data.createdAt == request.time;

      allow update: if isMember() && (
        // 본인: 닉네임과 프로필 사진만 (차단된 회원은 불가)
        (request.auth.uid == uid
          && resource.data.banned == false
          && changedOnly(['name', 'photoURL'])
          && validProfile(request.resource.data))
        // 주인: 언제든 자기 자신을 관리자로 되돌릴 수 있음
        || (request.auth.uid == uid && isOwner()
          && changedOnly(['role', 'banned'])
          && request.resource.data.role == 'admin'
          && request.resource.data.banned == false)
        // 관리자: 다른 회원의 권한과 차단 여부만
        || (request.auth.uid != uid && isAdmin()
          && changedOnly(['role', 'banned'])
          && request.resource.data.role in ['user', 'admin']
          && request.resource.data.banned is bool)
      );

      allow delete: if false;
    }

    // 이메일은 본인과 관리자만 볼 수 있음
    match /userEmails/{uid} {
      allow read: if isMember() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // ───── 게시물 ─────
    match /posts/{postId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'files', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 5
        && request.resource.data.createdAt == request.time;

      // 글 내용은 고칠 수 없고, 아래 두 가지만 바꿀 수 있음
      allow update: if isActive() && (
        // 반응: 반응 목록에서 '내 것'만 넣거나 빼기
        (changedOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
            || request.resource.data.reactions[request.auth.uid] in ['heart', 'like', 'laugh', 'wow', 'clap']))
        // 댓글 수: 한 번에 1씩만 늘리거나 줄이기
        || (changedOnly(['commentCount'])
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount >= 0
          && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
      );

      // 글쓴이 본인 또는 관리자
      allow delete: if isActive() && (resource.data.uid == request.auth.uid || isAdmin());

      // 첨부 파일 내용 (문서 하나에 파일 하나, 1MB 미만)
      match /files/{fileId} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 1000000;
        allow update: if false;
        allow delete: if isActive() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // 댓글
      match /comments/{commentId} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isActive() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ───── 신고: 누구나 보낼 수 있고, 관리자만 보고 지울 수 있음 ─────
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if isActive()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.keys().hasOnly(['postId', 'commentId', 'authorUid', 'preview', 'reason', 'reporter', 'createdAt'])
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 40
        && request.resource.data.commentId is string && request.resource.data.commentId.size() <= 40
        && request.resource.data.authorUid is string && request.resource.data.authorUid.size() <= 128
        && request.resource.data.preview is string && request.resource.data.preview.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ───── 게임 순위: 자기 기록만, 더 좋은 기록으로만 바꿀 수 있음 ─────
    match /games/{gameId}/scores/{uid} {
      allow read: if isActive();
      allow create, update: if isActive() && request.auth.uid == uid
        && gameId.matches('[a-z-]{1,20}')
        && request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 10000000
        && request.resource.data.updatedAt == request.time
        && (resource == null
          // 짝 맞추기만 숫자가 작을수록 좋은 기록
          || (gameId == 'memory'
            ? request.resource.data.score < resource.data.score
            : request.resource.data.score > resource.data.score));
      // 수상한 기록은 관리자가 지울 수 있음
      allow delete: if isAdmin();
    }
  }
}
